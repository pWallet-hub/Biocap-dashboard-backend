# Copy to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_URL=http://localhost:3000
# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx or a load balancer). Leave empty if none.
TRUST_PROXY=
# Optional: shared cache and rate-limit store. Without it the app uses per-process fallbacks.
REDIS_URL=redis://127.0.0.1:6379
# Requests per IP per 15 minutes across /api (default 1000)
API_RATE_LIMIT_MAX=1000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/biocap_db

# Auth: generate with `openssl rand -hex 64`
JWT_SECRET=

# Email via Resend. RESEND_FROM must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Biocap <noreply@your-verified-domain>"

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
