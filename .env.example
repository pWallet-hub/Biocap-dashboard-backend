# ─────────────────────────────────────────────────────────────────────────────
# Biocap backend configuration
# Copy to .env (local) or set these in your hosting platform (production).
# Never commit real values. Generate secrets with:  openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────────────────

# ── Required (server refuses to start without these) ─────────────────────────
# MongoDB connection string (Atlas: mongodb+srv://user:password@cluster/db?retryWrites=true&w=majority)
# Percent-encode special characters in the password (@ becomes %40).
MONGO_URI=

# Signs access tokens. Production: at least 32 characters.
JWT_SECRET=

# Signs refresh tokens. Must differ from JWT_SECRET. Production: at least 32 characters.
REFRESH_TOKEN_SECRET=

# ── Required in production (NODE_ENV=production) ─────────────────────────────
NODE_ENV=development

# Allowed browser origin(s) for CORS, comma-separated, e.g. https://dashboard.example.org
FRONTEND_URL=http://localhost:3000

# Email (Resend). The sender domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Biocap <noreply@your-verified-domain>"

# Cloudinary (image and document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=5000

SERVER_URL=

REDIS_URL=redis://127.0.0.1:6379 

TRUST_PROXY=

API_RATE_LIMIT_MAX=1000

JWT_EXPIRES_IN=7d

# ── AFS single sign-on (optional). Biocap signs people in through AFS Command Center's Keycloak. ──
# Off unless AFS_SSO_ENABLED=true. When on, every AFS_* setting below is required.
AFS_SSO_ENABLED=false
AFS_OIDC_ISSUER=
# Issuer as this API reaches Keycloak on the internal network (defaults to AFS_OIDC_ISSUER)
AFS_OIDC_INTERNAL_ISSUER=
# Production: http://afs-keycloak:8080/realms/afs (Keycloak on the shared afs-internal network)
AFS_OIDC_CLIENT_ID=biocap
AFS_OIDC_CLIENT_SECRET=
# This API's callback, exactly as registered for the client in AFS (…/api/auth/sso/callback)
AFS_OIDC_REDIRECT_URI=
# Frontend address, where people are sent after sign-in
AFS_PORTAL_URL=
# AFS Command Center, reached over the internal network (not through the public site)
AFS_COMMAND_CENTER_URL=
# Production: http://afs-command-center-backend:8000 (its /api/internal/ routes are not reachable publicly)
AFS_SERVICE_TOKEN=
AFS_APP_SLUG=biocap

# Days before a user must change their password (default 90)
PASSWORD_EXPIRY_DAYS=90

MAIL_FROM_NAME=Biocap
MAIL_FROM=noreply@your-verified-domain
