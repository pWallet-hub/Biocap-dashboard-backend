# ─────────────────────────────────────────────────────────────────────────────
# Biocap backend configuration
# Copy to .env (local) or set these in your hosting platform (production).
# Never commit real values. Generate secrets with:  openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────────────────

# ── Required (server refuses to start without these) ─────────────────────────
# MongoDB connection string (Atlas: mongodb+srv://user:password@cluster/db?retryWrites=true&w=majority)
# Percent-encode special characters in the password (@ becomes %40).
MONGO_URI=

# Signs access tokens. Production: at least 32 characters.
JWT_SECRET=

# Signs refresh tokens. Must differ from JWT_SECRET. Production: at least 32 characters.
REFRESH_TOKEN_SECRET=

# ── Required in production (NODE_ENV=production) ─────────────────────────────
NODE_ENV=development

# Allowed browser origin(s) for CORS, comma-separated, e.g. https://dashboard.example.org
FRONTEND_URL=http://localhost:3000

# Email (Resend). The sender domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Biocap <noreply@your-verified-domain>"

# Cloudinary (image and document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Port the API listens on (default 5000). Keep it in step with your proxy or platform.
PORT=5000

# Public URL of the API, used by Swagger "Try it out" when it differs from the host serving the docs
SERVER_URL=

# Shared cache and rate-limit store (Redis). Without it, the app uses per-process memory.
# docker-compose sets this to the bundled Redis service.
REDIS_URL=redis://127.0.0.1:6379

# Number of reverse-proxy hops in front of the API (1 behind one proxy). Leave empty if none.
TRUST_PROXY=

# Requests per IP per 15 minutes across /api (default 1000)
API_RATE_LIMIT_MAX=1000

# Access-token lifetime, e.g. 7d or 12h (default 7d)
JWT_EXPIRES_IN=7d

# Days before a user must change their password (default 90)
PASSWORD_EXPIRY_DAYS=90

# Sender name and address used by the mail helper when RESEND_FROM is not set
MAIL_FROM_NAME=Biocap
MAIL_FROM=noreply@your-verified-domain

# ── Scripts only (not read by the server) ────────────────────────────────────
# MONGODB_URI is accepted as an alias for MONGO_URI by the seed and migration scripts
# DRY_RUN=1 makes scripts/sendTestEmails.js render emails without sending them
